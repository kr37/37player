{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "37 Player",
  "version": "1.4.196",
  "identifier": "com.player37.app",
  "build": {
    "frontendDist": "../dist",
    "beforeDevCommand": "node copy-app.mjs",
    "beforeBuildCommand": "node copy-app.mjs"
  },
  "app": {
    "windows": [
      {
        "title": "37 Player",
        "width": 1300,
        "height": 900,
        "minWidth": 360,
        "minHeight": 320,
        "dragDropEnabled": false,
        "label": "main",
        "useHttpsScheme": true
      }
    ],
    "security": {
      "csp": null
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": [
      "msi",
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
