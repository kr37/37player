{
 "name": "37 Player",
 "short_name": "37 Player",
 "id": "./37-player.html",
 "start_url": "./37-player.html",
 "scope": "./",
 "display": "standalone",
 "orientation": "any",
 "background_color": "#181A22",
 "theme_color": "#181A22",
 "icons": [
  {
   "src": "data:image/png;base64,",
   "sizes": "192x192",
   "type": "image/png",
   "purpose": "any"
  },
  {
   "src": "data:image/png;base64,",
   "sizes": "512x512",
   "type": "image/png",
   "purpose": "any"
  }
 ],
 "launch_handler": {
  "client_mode": "focus-existing"
 },
 "file_handlers": [
  {
   "action": "./37-player.html",
   "accept": {
    "audio/mpeg": [
     ".mp3",
     ".mp2"
    ],
    "audio/mp4": [
     ".m4a",
     ".m4b"
    ],
    "audio/aac": [
     ".aac"
    ],
    "audio/wav": [
     ".wav",
     ".w64"
    ],
    "audio/x-wav": [
     ".wav"
    ],
    "audio/flac": [
     ".flac"
    ],
    "audio/ogg": [
     ".ogg",
     ".oga",
     ".opus",
     ".spx"
    ],
    "audio/aiff": [
     ".aif",
     ".aiff",
     ".aifc"
    ],
    "audio/x-aiff": [
     ".aif",
     ".aiff",
     ".aifc"
    ],
    "audio/x-ms-wma": [
     ".wma"
    ],
    "audio/webm": [
     ".webm"
    ],
    "audio/x-ape": [
     ".ape"
    ],
    "audio/x-wavpack": [
     ".wv"
    ],
    "audio/x-caf": [
     ".caf"
    ],
    "audio/amr": [
     ".amr"
    ],
    "audio/x-matroska": [
     ".mka"
    ],
    "audio/ac3": [
     ".ac3",
     ".eac3"
    ],
    "audio/basic": [
     ".au",
     ".snd"
    ]
   }
  },
  {
   "action": "./37-player.html",
   "accept": {
    "application/x-37player-backup": [
     ".37p"
    ]
   }
  }
 ],
 "share_target": {
  "action": "./37-player.html?share-target",
  "method": "POST",
  "enctype": "multipart/form-data",
  "params": {
   "files": [
    {
     "name": "audio",
     "accept": [
      "audio/*",
      ".aac",
      ".ac3",
      ".aif",
      ".aifc",
      ".aiff",
      ".amr",
      ".ape",
      ".au",
      ".caf",
      ".eac3",
      ".flac",
      ".m4a",
      ".m4b",
      ".mka",
      ".mp2",
      ".mp3",
      ".oga",
      ".ogg",
      ".opus",
      ".snd",
      ".spx",
      ".w64",
      ".wav",
      ".webm",
      ".wma",
      ".wv"
     ]
    }
   ]
  }
 }
}
